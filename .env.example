# Local-only dummy credentials for Postgres. Copy to .env (gitignored).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# Bucket created by Terraform (infra/). Must be globally unique; the output of `terraform output bucket_name`.
MLFLOW_BUCKET=

# Forward stdlib loggers under `taxi.*` to Prefect, so task logs show up in the run (and UI).
PREFECT_LOGGING_EXTRA_LOGGERS=taxi

# Optional: record flow runs on a long-running local Prefect server (`uv run prefect server start`, UI on :4200).
# Leave unset to use the temporary server that each run starts and stops (what CI and a clean clone use).
# PREFECT_API_URL=http://127.0.0.1:4200/api
