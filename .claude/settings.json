{
  "outputStyle": "Mentor",
  "permissions": {
    "allow": [
      "Bash(make:*)", "Bash(uv run:*)", "Bash(uv add:*)", "Bash(pytest:*)", "Bash(ruff:*)",
      "Bash(docker compose ps:*)", "Bash(docker compose logs:*)",
      "Bash(dvc status:*)", "Bash(dvc diff:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(terraform plan:*)", "Bash(terraform validate:*)"
    ],
    "ask": [
      "Bash(terraform apply:*)", "Bash(terraform destroy:*)", "Bash(aws:*)",
      "Bash(dvc push:*)", "Bash(git push:*)", "Bash(git commit:*)", "Bash(docker compose down:*)"
    ],
    "deny": ["Read(./.env)", "Read(./**/*.pem)"]
  }
}
