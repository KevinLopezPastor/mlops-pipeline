{
  "permissions": {
    "allow": ["Bash(make:*)", "Bash(uv run:*)", "Bash(pytest:*)", "Bash(ruff:*)",
              "Bash(kubectl get:*)", "Bash(kubectl logs:*)", "Bash(terraform plan:*)"],
